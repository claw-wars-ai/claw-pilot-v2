    "env_vars": [
      "CLAW_VERIFY_WRITE_ENDPOINT",
      "CLAW_VERIFY_READ_PATH"
    ],
    "pii_policy": "anonymous_only",
    "verified_user_runs_require_lane": true
  },
  "notes": "GitHub Pages cannot host the write collector. Verified-user pilots require this shared operator-managed verification lane and append-only event export."
}
